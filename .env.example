# Copie para .env.local no desenvolvimento.
# Configure valores separados na Vercel para Development, Preview e Production.
# Nunca envie valores reais ou chaves secretas ao Git.

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA — chaves devem permanecer apenas no servidor
GEMINI_API_KEY=
OPENAI_API_KEY=
OMNIROUTE_URL=
OMNIROUTE_MODEL=

# Automações
N8N_WEBHOOK_URL=
N8N_API_KEY=

# Mapas
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Módulos legados — necessários somente enquanto app/ estiver ativo
APP_ID=
APP_SECRET=
DATABASE_URL=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=

# Deploy programático — server-side somente
VERCEL_TOKEN=
VERCEL_ORG_ID=
